# ============================================================================
# reasonix.toml.example — HOS-Save-Cost MCP 层配置（可跟踪模板）
# v2.0 补充
# ---------------------------------------------------------------------------
# 【注意】`.gitignore` 忽略了真实文件 `reasonix.toml`（原因见下）。本文件是
#   可跟踪的模板；部署时复制为本地文件再按环境修改：
#       cp integration/reasonix.toml.example <部署根>/.kiro/integration/reasonix.toml
#   项目文档中凡提到 `integration/reasonix.toml`，指的都是这份模板对应的
#   本地生成文件，而非仓库内已提交文件。
#
# 定位：HOS-Save-Cost 四层互补架构中的「MCP / 工具定义层」。
# 目标：只启用真正需要的 MCP server，避免 40+ 工具 schema 全量进入模型上下文。
#
# 用法：
#   - 原生 `[[plugins]]` stdio 直连（Reasonix 语法），不经过中间压缩层。
#   - 原则：最小化、按需订阅。缺一补一，不批量启用。
#   - 若后续安装到可用的「MCP 压缩/网关代理」，再用 `args` 包装（见下方示例注释）。
#
# ⚠️ 重要：`mcp-compressor` 在 npm registry 上【不存在】（E404），
#    不能 `npx mcp-compressor`，勿照抄网上旧方案。工具 schema 的节省靠
#    「只配置用得到的 server」实现，而不是靠一个不存在的压缩工具。
#
# ⚠️ 为何真实文件被 gitignore：reasonix.toml 含环境相关的 API 地址、凭证、
#    代理开关，属「本地工具配置」，按仓库约定不入版本库（见根 .gitignore
#    `# Reasonix local tool config` 段）。模板只提供结构与默认值。
# ============================================================================

# ---------------------------------------------------------------------------
# 01. 上下文预算（可选，配合 skills/workflow/token-monitor.skill）
#     max_context_chars   : 控制台输出的最大上下文字符数
#     max_tool_output_chars: 单次工具输出的字符上限
# ---------------------------------------------------------------------------
[context]
max_context_chars = 100000
max_tool_output_chars = 15000

# ---------------------------------------------------------------------------
# 02. 最小化工具集（原生 [[plugins]] 直连）
#     规则：只保留你当前会话真正会用到的 server。
#     - 代码探索（大库）：启用 codegraph（预索引知识图谱，替代反复 grep/read）
#     - 版本管理：git（可选，Reasonix 若内置可不开）
#     - 其余一律不配，等需要时再加一行。
# ---------------------------------------------------------------------------
[[plugins]]
name = "codegraph"
description = "预索引代码知识图谱，替代逐个 Read/Grep，实测省约 57% token"
command = "npx"
args = ["-y", "@codegraph/mcp"]
enabled = true
# tags = ["code-intelligence"]          # 可选：便于按需订阅过滤

# ---------------------------------------------------------------------------
# 示例：MCP 压缩/网关代理（仅当你真的安装到可用的代理时才启用）
#     启用后，把上面的 server 收进网关，再在这里包装成 1 个入口。
# ---------------------------------------------------------------------------
# [[plugins]]
# name = "mcp-gateway"
# description = "统一工具入口（可选网关代理）"
# command = "npx"
# args = ["-y", "your-gateway-package"]
# enabled = false
# # ⚠️ mcp-compressor 不存在；写死这里只是演示「网关包装」的写法，勿直接使用

# ---------------------------------------------------------------------------
# 03. 工具订阅过滤（进一步压低 schema token）
#     如果运行时支持按工具名白名单订阅，只开放真正被调度的工具：
# ---------------------------------------------------------------------------
# [tool_filter]
# mode = "allowlist"
# allow = ["codegraph", "git_diff", "read"]
