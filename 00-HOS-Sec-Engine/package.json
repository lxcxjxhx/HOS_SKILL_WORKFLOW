{
  "name": "hos-sec-engine",
  "version": "1.0.0",
  "description": "HOS攻防实战规则引擎 - 将实战经验转化为标准化、可执行的攻防规则",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hos-sec-engine": "dist/src/scripts/deploy-skills.js",
    "deploy-hos-skills": "dist/src/scripts/deploy-skills.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/examples/usage.js",
    "dev": "tsc --watch",
    "postbuild": "node dist/src/scripts/generate-skills-md.js",
    "generate-skills-md": "node dist/src/scripts/generate-skills-md.js",
    "deploy": "node dist/src/scripts/deploy-skills.js",
    "deploy:global": "node dist/src/scripts/deploy-skills.js --global",
    "deploy:claude": "node dist/src/scripts/deploy-skills.js --claude",
    "deploy:trae": "node dist/src/scripts/deploy-skills.js --trae",
    "postinstall": "node dist/src/scripts/deploy-skills.js || echo 'Skill deployment skipped (run npm run deploy to deploy skills manually)'"
  },
  "keywords": ["security", "offense-defense", "rule-engine", "waf-bypass", "vulnerability", "skill", "claude-code", "penetration-testing"],
  "author": "HOS-Sec",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "skills/**/*",
    "src/types/**/*"
  ],
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
