{
  "name": "hos-sec-engine",
  "version": "0.5.0",
  "description": "HOS攻防实战规则引擎 - 将实战经验转化为标准化、可执行的攻防规则",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "hos-sec-engine": "dist/src/cli/index.js",
    "hos-skills": "scripts/install-skills.js"
  },
  "scripts": {
    "build": "npm run clean && tsc && node dist/src/scripts/postbuild.js",
    "start": "node dist/examples/usage.js",
    "dev": "tsc --watch",
    "postbuild": "node dist/src/scripts/postbuild.js",
    "clean": "node -e \"const fs=require('fs');['dist','skills'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}));console.log('Cleaned dist/ and skills/');\"",
    "generate-bundled-skill": "node dist/src/scripts/generate-bundled-skill.js",
    "generate-skills-md": "node dist/src/scripts/generate-skills-md.js",
    "generate-playbooks-md": "node dist/src/scripts/generate-playbooks-md.js",
    "generate-skills-index": "node dist/src/scripts/generate-skills-index.js",
    "generate:cwe": "node dist/src/scripts/generate-skills-from-cwe.js",
    "generate:cwe:web": "node dist/src/scripts/generate-skills-from-cwe.js --category web",
    "generate:cwe:api": "node dist/src/scripts/generate-skills-from-cwe.js --category api",
    "generate:cwe:cloud": "node dist/src/scripts/generate-skills-from-cwe.js --category cloud",
    "lifecycle:status": "node -e \"const l=require('./dist/src/core/skill-lifecycle').skillLifecycle; console.log('Active:', l.getActiveSkills().length); console.log('Changes:', l.getChangeLog().length); l.persist();\"",
    "lifecycle:changelog": "node -e \"const l=require('./dist/src/core/skill-lifecycle').skillLifecycle; l.getChangeLog().forEach(e=>console.log(e.timestamp.slice(0,10), e.changeType, e.skillId, 'v'+e.version, ':', e.description));\"",
    "deploy": "node dist/src/scripts/deploy-skills.js",
    "deploy:global": "node dist/src/scripts/deploy-skills.js --global",
    "deploy:claude": "node dist/src/scripts/deploy-skills.js --claude",
    "deploy:trae": "node dist/src/scripts/deploy-skills.js --trae",
    "install:skills": "node scripts/install-skills.js install",
    "postinstall": "node scripts/install-skills.js install --no-source || node dist/src/scripts/deploy-skills.js || echo 'Skill deployment skipped (run npm run deploy to deploy skills manually)'",
    "test": "node tests/core/engine-test.js",
    "test:integration": "node tests/integration/full-verification.js",
    "test:core": "node tests/core/engine-test.js"
  },
  "keywords": ["security", "offense-defense", "rule-engine", "waf-bypass", "vulnerability", "skill", "claude-code", "penetration-testing"],
  "author": "HOS-Sec",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "src/**/*",
    "skills/**/*",
    "scripts/install-skills.js",
    "install-lite.js",
    "skills-index.json",
    "README.md",
    "tsconfig.json"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "@inquirer/prompts": "^5.0.0",
    "@inquirer/checkbox": "^2.3.0",
    "@inquirer/select": "^2.3.0",
    "@inquirer/confirm": "^3.1.0",
    "@inquirer/input": "^2.1.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
