    "todo_with_ai": {
      "aliases": ["AI todo", "智能待办", "smart task"],
      "level": "MEDIUM",
      "detection": {
        "keywords": ["AI", "smart task", "智能"],
        "parentPattern": "todo_app",
        "requireParent": true
      },
      "tags": ["HOT_TOPIC", "TEMPLATE_TRAP"],
      "note": "AI + 模板 ≠ 创新，检查 AI 部分是否有真正的智能而非 wrapper"
    }
  },

  "compoundDetectors": [
    {
      "id": "fullstack_demo_starter",
      "description": "标准全栈 starter 检测",
      "indicators": [
        "同时包含前端+后端+数据库",
        "使用了 Next.js / Nuxt / Remix 等元框架",
        "项目结构为 pages+api+components 标准结构",
        "无特殊领域逻辑"
      ],
      "minMatch": 3,
      "level": "MEDIUM",
      "tags": ["TEMPLATE_TRAP"]
    },
    {
      "id": "ai_wrapper",
      "description": "纯 AI API 包装器（无附加值）",
      "indicators": [
        "直接调用 OpenAI / Claude API",
        "无 prompt engineering 层",
        "无 RAG / fine-tune / 自定义逻辑",
        "纯 chat UI"
      ],
      "minMatch": 3,
      "level": "MEDIUM",
      "tags": ["HOT_TOPIC", "TEMPLATE_TRAP"]
    },
    {
      "id": "tutorial_reproduction",
      "description": "教程级复现项目",
      "indicators": [
        "有 TODO.md 跟随教程步骤",
        "使用特定教程的技术栈（无理由）",
        "项目结构对应教程章节",
        "Readme 包含教程来源链接"
      ],
      "minMatch": 2,
      "level": "MEDIUM",
      "tags": ["LEARNING_OK"]
    }
  ],

  "positiveIndicators": {
    "领域深度": [
      "domain model", "DDD", "bounded context", "领域事件",
      "业务规则引擎", "workflow engine", "状态机"
    ],
    "架构质量": [
      "hexagonal", "clean architecture", "onion",
      "CQRS", "event sourcing", "event-driven",
      "微服务设计模式", "message broker"
    ],
    "工程实践": [
      "单元测试覆盖率", "契约测试", "集成测试",
      "CI/CD pipeline", "基础设施即代码",
      "监控/可观测性", "OpenTelemetry"
    ],
    "安全实践": [
      "OWASP", "zero trust", "secret管理",
      "加密存储", "审计日志", "RBAC"
    ]
  }
