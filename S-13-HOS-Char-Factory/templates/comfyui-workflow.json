{
  "_comment": "HOS-CHAR-FACTORY 标准出图节点图（ComfyUI API 格式，/prompt 接口直接 POST）。节点 8/9 为可选 RMBG 抠图链路：把 6 的输出改接 8 即可出图即抠图。",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "ponyDiffusionV6XL_v6StartWithThisOne.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "1girl, flat color anime style, clean line art, cel shading, no complex shadows, side profile, full body, very long hair, amber eyes, gentle smile, hourglass figure, large breasts, female outfit, pure white background, masterpiece, best quality, highres"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "lowres, bad anatomy, bad hands, missing fingers, extra digits, deformed, blurry, jpeg artifacts, watermark, text, photorealistic, 3d render, complex background, worst quality"
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 832,
      "height": 1472,
      "batch_size": 1
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0],
      "seed": 20260806,
      "steps": 28,
      "cfg": 6.5,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["5", 0],
      "vae": ["1", 2]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["6", 0],
      "filename_prefix": "hcf/still"
    }
  },
  "8": {
    "class_type": "RemoveBackground",
    "inputs": {
      "image": ["6", 0],
      "model_name": "RMBG-1.4"
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["8", 0],
      "filename_prefix": "hcf/cutout"
    }
  }
}
