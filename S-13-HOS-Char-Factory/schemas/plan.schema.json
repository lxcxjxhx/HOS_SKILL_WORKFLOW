{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/lxcxjxhx/HOS_SKILL_WORKFLOW/S-13-HOS-Char-Factory/schemas/plan.schema.json",
  "title": "HCF ProductionPlan",
  "description": "HOS-CHAR-FACTORY 生产计划（Planner 产物）",
  "type": "object",
  "required": ["id", "content_mode", "character", "target"],
  "properties": {
    "id": {"type": "string", "pattern": "^HCF-"},
    "content_mode": {"type": "string", "enum": ["sfw", "nsfw"]},
    "adult_decl": {
      "type": "object",
      "required": ["adult", "age", "identity"],
      "properties": {
        "adult": {"const": true},
        "age": {"type": "integer", "minimum": 18},
        "identity": {"type": "string"}
      }
    },
    "lewdness": {"type": "string", "enum": ["mild", "moderate", "explicit"]},
    "character": {
      "type": "object",
      "required": ["name", "style"],
      "properties": {
        "name": {"type": "string"},
        "hair": {"type": "string"},
        "eyes": {"type": "string"},
        "style": {"type": "string"}
      }
    },
    "target": {
      "type": "array",
      "items": {"type": "string", "enum": ["still", "chain", "cutout", "sheet", "anim"]}
    },
    "diff_axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slot", "from", "to", "range"],
        "properties": {
          "slot": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "range": {
            "type": "array",
            "items": {"type": "number", "minimum": 0, "maximum": 1},
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "scale": {
      "type": "object",
      "properties": {
        "stills": {"type": "integer", "minimum": 1},
        "chain_frames": {"type": "integer", "minimum": 2}
      }
    },
    "cost_estimate_sec": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"content_mode": {"const": "nsfw"}}},
      "then": {"required": ["adult_decl", "lewdness"]}
    }
  ]
}
