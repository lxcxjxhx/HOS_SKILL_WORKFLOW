{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/lxcxjxhx/HOS_SKILL_WORKFLOW/S-13-HOS-Char-Factory/schemas/output.schema.json",
  "title": "HCF OutputManifest",
  "description": "HOS-CHAR-FACTORY 产物清单（Packager 输出，随 out/ 目录归档）",
  "type": "object",
  "required": ["plan_id", "mode", "seed", "artifacts"],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^HCF-"},
    "mode": {"type": "string", "enum": ["sfw", "nsfw"]},
    "seed": {"type": "integer"},
    "created_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": {"type": "string", "enum": ["still", "chain_frame", "cutout", "sheet", "anim", "parts"]},
          "path": {"type": "string"},
          "prompt_id": {"type": "string"},
          "params": {"type": "object"}
        }
      }
    }
  }
}
