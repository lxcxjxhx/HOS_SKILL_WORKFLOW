# AI Provider Configuration
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60000

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-opus-20240229

# Local Model (Ollama, etc.)
LOCAL_MODEL_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama3

# Runtime Configuration
HOS_SEC_ACTIVE_PROVIDER=openai
HOS_SEC_MAX_CONCURRENT_AGENTS=3
HOS_SEC_AGENT_TIMEOUT=600000
HOS_SEC_SANDBOX_ENABLED=true
HOS_SEC_SANDBOX_NETWORK=restricted
HOS_SEC_ENCRYPTION_KEY=your-32-byte-encryption-key!!

# Target for Skill execution
HOS_SEC_TARGET=https://example.com
